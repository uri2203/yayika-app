# Copy this file to .env and fill in local values. Never commit .env.
#
# Supabase Management API token (use a short-lived, minimum-privilege token).
# Required by scripts/deploy-*.js, scripts/fix-*-db.js and scripts/run-migration.js.
SUPABASE_ACCESS_TOKEN=

# Supabase project ref (not secret). Defaults to the value used by the scripts.
SUPABASE_PROJECT_REF=odbhxiymteppgaqqdsoy

# Database password for the local/diagnostic pg scripts.
# Required by scripts/try-connect*.js, scripts/raw-tls.js and scripts/run-all-migrations.js.
SUPABASE_DB_PASSWORD=

# Safety gate for scripts that execute DDL. Set to 1 ONLY after a backup and a
# staging review. Leave unset for read-only diagnostics.
SUPABASE_ALLOW_DB_WRITES=
